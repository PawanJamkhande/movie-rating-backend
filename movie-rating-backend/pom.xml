<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
<!--This parent automatically provides:
Compatible dependency versions, Build configuration, Plugin versions, Compiler settings, Spring Boot defaults -->
    <parent>
        <groupId>org.springframework.boot</groupId> 
        <artifactId>spring-boot-starter-parent</artifactId> 
        <version>3.3.4</version>
        <relativePath/>
    </parent>

    <groupId>com.movierating</groupId> <!--This is like a companies name space defined by groupId-->
    <artifactId>movie-rating-system-backend</artifactId> <!--This is our project name defined by artifactId-->
         <!--the SNAPSHOT is used because this project is under development, the actual project has 1.0.0, 2.0.1 without snapshot-->
    <version>0.0.1-SNAPSHOT</version>
    <name>movie-rating-system-backend</name>
    <description>Movie Rating System Backend</description>

    <properties>
             <!--this is java version 17 bcz springboot 3.0x requires java 17 or newer versions-->
        <java.version>17</java.version>
    </properties>

    <dependencies>
        <!-- Web -->
             <!--Dependencies are the libraries that are crusial or needed to build a project-->
        <dependency>
                 <!--this dependency gives what we need to build RESTAPI's-->
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- JPA / Hibernate (auto creates tables) communication bridge between Java and SQL-->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Validation used for annotations like @NotBlank and all-->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- This is Spring Security (only used for BCryptPasswordEncoder + CORS/CSRF config, same as library project) 
             We are not using JWT (Json web token)-->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- MySQL Driver provides the knowledge over how to communicate with MySQL -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Lombok - It is used to reduce the boilerplate code like getter setter toString and all by defining @Getter @Setter or @Data -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>movie-rating-system-backend</finalName> 
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId> <!--This creates the executable JAR file of our project so we can run JAR file wihtout installing TOMCAT-->
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
